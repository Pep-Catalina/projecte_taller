FROM mariadb:latest

LABEL author="Pep Catalina i Guillem Torres"
LABEL title="MariaDB con Backup"
LABEL version="1.0"

# Instalar cron
RUN apt update && \
    apt install -y cron && \
    apt clean && \
    mkdir -p /Backup_MySQL

# Copiar scripts y ficheros
COPY init.sql /docker-entrypoint-initdb.d/init.sql
COPY backup.sh /Backup_MySQL/backup.sh
COPY my-contrab.txt /etc/cron.d/db-backup

# Establecer permisos y registrar cron
RUN chmod +x /Backup_MySQL/backup.sh && \
    chmod 0644 /etc/cron.d/db-backup && \
    crontab /etc/cron.d/db-backup

# No sobrescribir el ENTRYPOINT y dejar el CMD por defecto
CMD ["mariadbd"]
