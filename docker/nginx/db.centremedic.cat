;
; BIND data file for local loopback interface
;
$ORIGIN centremedic.cat.
$TTL	604800
@	IN	SOA	centremedic.cat. root.centremedic.cat. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;

@	IN	NS	ns1

ns1 	IN 	A 		192.168.1.1
srv-web	IN	A		192.168.1.1
www		IN	CNAME	srv-web

srv-api	IN	A		192.168.1.2
api		IN	CNAME	srv-api

srv-db	IN	A		192.168.1.3
mysql	IN	A		srv-db